#!/bin/bash
# Syndra - Commande principale de gestion
# Usage: syndra [command]

INSTALL_DIR="$HOME/.config/SyndraShell"
REPO_URL="https://github.com/Fud0o0/Syndra.git"

show_help() {
    echo "╔═══════════════════════════════════════════════════════════════╗"
    echo "║                    SYNDRA - COMMANDES                         ║"
    echo "╚═══════════════════════════════════════════════════════════════╝"
    echo ""
    echo "Usage: syndra [commande]"
    echo ""
    echo "Commandes disponibles:"
    echo "  update          Mettre à jour Syndra vers la dernière version"
    echo "  restart         Redémarrer l'interface Syndra"
    echo "  provisional     Lancer l'interface provisoire"
    echo "  autostart       Gérer le lancement automatique"
    echo "  version         Afficher la version actuelle"
    echo "  help            Afficher cette aide"
    echo ""
}

update_syndra() {
    echo "╔═══════════════════════════════════════════════════════════════╗"
    echo "║              MISE À JOUR DE SYNDRA SHELL                      ║"
    echo "╚═══════════════════════════════════════════════════════════════╝"
    echo ""
    
    if [ ! -d "$INSTALL_DIR" ]; then
        echo "❌ Syndra n'est pas installé dans $INSTALL_DIR"
        exit 1
    fi
    
    cd "$INSTALL_DIR"
    
    echo "📡 Récupération des mises à jour..."
    git fetch origin
    
    # Check if updates are available
    LOCAL=$(git rev-parse @)
    REMOTE=$(git rev-parse @{u})
    
    if [ "$LOCAL" = "$REMOTE" ]; then
        echo "✅ Syndra est déjà à jour!"
        echo ""
        git log -1 --pretty=format:"Version actuelle: %h - %s (%ar)"
        echo ""
    else
        echo "🔄 Mise à jour disponible!"
        echo ""
        echo "Derniers changements:"
        git log --oneline HEAD..@{u} | head -5
        echo ""
        
        read -p "Continuer la mise à jour? [Y/n]: " -n 1 -r
        echo
        
        if [[ ! $REPLY =~ ^[Nn]$ ]]; then
            echo "📦 Téléchargement des mises à jour..."
            git pull origin main
            
            echo "🔧 Installation des nouvelles dépendances..."
            if [ -f "requirements.txt" ]; then
                pip install --user --break-system-packages -r requirements.txt --upgrade
            fi
            
            echo "♻️  Redémarrage de Syndra..."
            pkill -f "python.*main.py" || true
            sleep 1
            python "$INSTALL_DIR/main.py" > /dev/null 2>&1 & disown
            
            echo ""
            echo "✅ Mise à jour terminée avec succès!"
            echo ""
        else
            echo "Mise à jour annulée."
        fi
    fi
}

restart_syndra() {
    echo "♻️  Redémarrage de Syndra..."
    pkill -f "python.*main.py" || true
    sleep 1
    python "$INSTALL_DIR/main.py" > /dev/null 2>&1 & disown
    echo "✅ Syndra redémarré!"
}

launch_provisional() {
    if [ -f "$INSTALL_DIR/provisional_interface.py" ]; then
        python "$INSTALL_DIR/provisional_interface.py"
    else
        echo "❌ Interface provisoire non trouvée"
        exit 1
    fi
}

manage_autostart() {
    if [ -f "$INSTALL_DIR/manage-autostart.sh" ]; then
        bash "$INSTALL_DIR/manage-autostart.sh" "$@"
    else
        echo "❌ Script de gestion autostart non trouvé"
        exit 1
    fi
}

show_version() {
    if [ -d "$INSTALL_DIR/.git" ]; then
        cd "$INSTALL_DIR"
        echo "Syndra Shell"
        git log -1 --pretty=format:"Version: %h%nDate: %ai%nAuteur: %an%nMessage: %s"
        echo ""
    else
        echo "❌ Impossible de déterminer la version"
    fi
}

# Main command handler
case "${1:-help}" in
    update)
        update_syndra
        ;;
    restart)
        restart_syndra
        ;;
    provisional)
        launch_provisional
        ;;
    autostart)
        shift
        manage_autostart "$@"
        ;;
    version)
        show_version
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        echo "❌ Commande inconnue: $1"
        echo ""
        show_help
        exit 1
        ;;
esac
